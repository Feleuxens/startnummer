# Copy to .env.docker. Use random hexadecimal values for the PostgreSQL password
# and the two secrets; the database password is embedded in a connection URL.
POSTGRES_PASSWORD=
STARTNUMMER_USERNAME=photographer
STARTNUMMER_PASSWORD=
STARTNUMMER_SESSION_SECRET=
STARTNUMMER_WORKER_SECRET=
# A separate Fernet key enables connection settings in Administration.
STARTNUMMER_INTEGRATION_KEY=

# Default: host reverse proxy connects through loopback, using HTTPS publicly.
STARTNUMMER_BIND_HOST=127.0.0.1
STARTNUMMER_PORT=8000
STARTNUMMER_COOKIE_SECURE=1
# Pin a published version, e.g. 0.1.0. Use edge before the first stable release.
STARTNUMMER_IMAGE_TAG=latest
# cpu, intel, or nvidia. NVIDIA also needs the GPU block in compose.yaml enabled.
STARTNUMMER_WORKER_VARIANT=cpu
# Override only for a fork or another registry namespace.
STARTNUMMER_IMAGE_NAMESPACE=ghcr.io/feleuxens
# Trust only the address/subnet of your reverse proxy when forwarding client IPs.
STARTNUMMER_TRUSTED_PROXY_IPS=127.0.0.1
STARTNUMMER_CACHE_MB=512
STARTNUMMER_FACE_SESSION_TTL=3600
STARTNUMMER_MAX_FILE_BYTES=52428800
STARTNUMMER_MAX_BATCH_BYTES=2147483648
STARTNUMMER_ROSTER_HOSTS=ergebnisse.leichtathletik.de

# Alternatively, uncomment BOTH to make Chevereto environment-managed.
# These hosts must be reachable from the API container, not just the Docker host.
# STARTNUMMER_CHEVERETO_URL=https://gallery.example.org
# STARTNUMMER_CHEVERETO_DSN=mysql://startnummer:password@gallery-db:3306/chevereto
