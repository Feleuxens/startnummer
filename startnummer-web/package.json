{
  "name": "startnummer-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "generate": "uv run --no-sync python ../scripts/export_openapi.py && openapi-typescript openapi.json -o src/api/schema.d.ts",
    "check": "npm run generate && astro check",
    "build": "npm run check && astro build",
    "test": "npm run build && playwright test",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}' 'tests/**/*.ts' '*.ts' '*.mjs' '*.json' DESIGN.md",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}' 'tests/**/*.ts' '*.ts' '*.mjs' '*.json' DESIGN.md"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.8",
    "@fontsource/inter": "^5.3.0",
    "astro": "^7.4.11",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.10.1",
    "typescript": "~5.9.3"
  }
}
