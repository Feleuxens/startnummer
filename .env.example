# Local test services from docker-compose.yml. Never point acceptance checks at production.
STARTNUMMER_DATABASE_URL=postgresql+psycopg://startnummer:startnummer@127.0.0.1:5432/startnummer
STARTNUMMER_BLOB_ROOT=.startnummer/photos
STARTNUMMER_USERNAME=photographer
STARTNUMMER_PASSWORD=change-this-local-password
STARTNUMMER_SESSION_SECRET=replace-with-at-least-32-random-characters
STARTNUMMER_WORKER_SECRET=replace-with-a-different-32-character-secret
STARTNUMMER_WORKER_URL=http://127.0.0.1:8766
STARTNUMMER_WORKER_PORT=8766
STARTNUMMER_FACE_SESSION_TTL=3600
# Defaults until changed through Administration.
STARTNUMMER_MAX_FILE_BYTES=52428800
STARTNUMMER_MAX_BATCH_BYTES=2147483648
STARTNUMMER_ROSTER_HOSTS=ergebnisse.leichtathletik.de
STARTNUMMER_CHEVERETO_URL=http://localhost:8115
STARTNUMMER_CHEVERETO_DSN=mysql://chevereto:user_database_password@127.0.0.1:3306/chevereto
# Set to 1 behind HTTPS; keep 0 only for local HTTP development.
STARTNUMMER_COOKIE_SECURE=0
